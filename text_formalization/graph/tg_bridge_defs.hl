(* ========================================================================= *)
(* tame/tame_bridge_defs.ml -- the representation maps between our graph     *)
(* datatype (tame_graph.ml) and Hales' tuple representation (hales_defs.ml): *)
(* a face (FACE vs t) becomes the pair (vs, t = Final), a graph              *)
(* (GRAPH fs n fss h) becomes the tuple (fs, n, fss, h) with the faces       *)
(* mapped.  HFACE/HGRAPH go to Hales' side, OFACE/OGRAPH come back; they are *)
(* mutually inverse bijections (tame_bridge_graph.ml).                       *)
(* ========================================================================= *)

flyspeck_needs "graph/tg_wf.hl";;
flyspeck_needs "graph/tg_hales_alias.hl";;

module Tg_bridge_defs = struct

open Tg_list;;
open Tg_graph;;
open Tg_enum;;
open Tg_tame;;
open Tg_iso;;
open Tg_exec;;
open Tg_check;;
open Tg_sound;;
open Tg_mono;;
open Tg_lbthm;;
open Tg_isothm;;
open Tg_newverts;;
open Tg_archive_data;;
open Tg_archive;;
open Tg_main;;
open Tg_hales_alias;;
open Tg_archive_bridge;;
open Tg_wf;;
open Tg_wf_inv;;

let HFACE = new_definition
 `HFACE f = (VERTICES f, FINAL_FACE f)`;;

let OFACE = new_definition
 `OFACE (p:num list # bool) =
    FACE (FST p) (if SND p then Final else Nonfinal)`;;

let HGRAPH = new_definition
 `HGRAPH g = (MAP HFACE (FACES g), COUNT_VERTICES g,
              MAP (MAP HFACE) (FACE_LIST_AT g), HEIGHTS g)`;;

let OGRAPH = new_definition
 `OGRAPH (hg:((num)list#bool)list#num#(((num)list#bool)list)list#(num)list) =
    GRAPH (MAP OFACE (faces hg)) (countVertices hg)
          (MAP (MAP OFACE) (faceListAt hg)) (heights hg)`;;
end;;
