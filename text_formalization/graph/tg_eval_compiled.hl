let f_XSEPARATED_PAIR_abs1 =
  let abs_def_62_case1 =
    match List.map standardize (local_split_thm abs_def_62) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_u = standardize_tm (mk_var ("u", `:num`)) in
  let var_f = standardize_tm (mk_var ("f", `:face`)) in
  let rec f_XSEPARATED_PAIR_abs1 u f opt_th =
    let base_th = trans_opt opt_th (INST [f, var_f; u, var_u] abs_def_62_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (a6, Comb (Comb (a4, Comb ((Comb (_, a3) as a2), Comb (a1, _))), a5)), (Comb (a8, Comb (a7, _)) as a9))) ->
      let r1 = f_VERTICES f None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_LENGTH_num (rand (concl r1)) (Some r2) in
      let r3 =
        let r3 = MK_COMB (REFL a2, r2) in
        f_LT a3 (rand (concl r2)) (Some r3) in
      let r4 =
        if is_true_th r3 then
          let a2_eq = f_FINAL_FACE f None in
          let and_th = INST[rand (concl a2_eq), p_var_bool] T_AND in
          TRANS (MK_COMB (MK_COMB (REFL a4, r3), a2_eq)) and_th
        else
          let th0 = MK_COMB (MK_COMB (REFL a4, r3), REFL a5) in
          let th1 = INST[a5, p_var_bool] F_AND in
          TRANS th0 th1 in
      if is_true_th r4 then
        let th0 = MK_COMB (MK_COMB (REFL a6, r4), REFL a9) in
        let th1 = INST[a9, p_var_bool] T_OR in
        TRANS (TRANS base_th th0) th1
      else
        let th0 = MK_COMB (MK_COMB (REFL a6, r4), REFL a9) in
        let th1 = INST[a9, p_var_bool] F_OR in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r5 =
          let r5 = MK_COMB (REFL a7, r1) in
          f_MEM_num u (rand (concl r1)) (Some r5) in
