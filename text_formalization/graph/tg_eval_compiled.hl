;;

let f_MINFACE_WF_abs1 =
  let abs_def_55_case1 =
    match List.map standardize (local_split_thm abs_def_55) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_g = standardize_tm (mk_var ("g", `:graph`)) in
  let var_x = standardize_tm (mk_var ("x", `:num`)) in
  let rec f_MINFACE_WF_abs1 g x opt_th =
    let base_th = trans_opt opt_th (INST [x, var_x; g, var_g] abs_def_55_case1) in
    match concl base_th with
    | Comb (_, Comb (a1, _)) ->
      let r1 = f_COUNT_VERTICES g None in
      let r2 = MK_COMB (REFL a1, r1) in
      f_LT x (rand (concl r1)) (Some (TRANS base_th r2))
    | _ -> failwith "bad pattern"
     in
  f_MINFACE_WF_abs1
;;

let f_MINFACE_WF =
  let no_abs_MINFACE_WF_case1 =
    match List.map standardize (local_split_thm no_abs_MINFACE_WF) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_g = standardize_tm (mk_var ("g", `:graph`)) in
  let var_f = standardize_tm (mk_var ("f", `:face`)) in
  let rec f_MINFACE_WF g f opt_th =
    let base_th = trans_opt opt_th (INST [f, var_f; g, var_g] no_abs_MINFACE_WF_case1) in
    match concl base_th with
    | Comb (_, Comb (Comb (_, Comb (a1, _)), (Comb (Comb (a5, Comb ((Comb (_, a4) as a3), Comb (a2, _))), (Comb ((Comb (_, a6) as a7), _) as a8)) as a9))) ->
      let r1 = f_VERTICES f None in
      let r2 =
        let r2 = MK_COMB (REFL a1, r1) in
        f_DISTINCT_num (rand (concl r1)) (Some r2) in
      if is_true_th r2 then
        let th0 = MK_COMB (MK_COMB (REFL a5, r2), REFL a9) in
        let th1 = INST[a9, p_var_bool] T_AND in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r3 =
          let r3 = MK_COMB (REFL a2, r1) in
          f_LENGTH_num (rand (concl r1)) (Some r3) in
        let r4 =
          let r4 = MK_COMB (REFL a3, r3) in
          f_LE a4 (rand (concl r3)) (Some r4) in
        if is_true_th r4 then
          let th0 = MK_COMB (MK_COMB (REFL a5, r4), REFL a8) in
          let th1 = INST[a8, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r5 = (a6, f_MINFACE_WF_abs1 g) in
          let r6 = MK_COMB (REFL a7, r1) in
          f_ALL_num r5 (rand (concl r1)) (Some (TRANS base_th r6))
        else
          let th0 = MK_COMB (MK_COMB (REFL a5, r4), REFL a8) in
          let th1 = INST[a8, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      else
        let th0 = MK_COMB (MK_COMB (REFL a5, r2), REFL a9) in
        let th1 = INST[a9, p_var_bool] F_AND in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
  f_MINFACE_WF
;;
end;;
