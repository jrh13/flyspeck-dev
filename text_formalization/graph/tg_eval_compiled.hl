      )
    | _ -> failwith "No match: f_SUBDIV_FACE_REC"
    
  and f_SUBDIV_FACE_REC_abs2 tm1 tm2 tm3 opt_th =
    match (tm1, tm2, tm3) with
    | (vos, v, Comb (Comb (Const (",", _), f1), Comb (Comb (Const (",", _), f2), g))) ->
