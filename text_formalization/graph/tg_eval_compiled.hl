          let base_th = TRANS (TRANS base_th th0) th1 in
          let r2 = f_SUB n a4 None in
          let r3 =
            let r3 = MK_COMB (MK_COMB (REFL a5, r2), REFL h) in
            f_UPDATE_AT_face_list xs (rand (concl r2)) (h, func_h) (Some r3) in
          TRANS base_th (MK_COMB (REFL a6, r3))
