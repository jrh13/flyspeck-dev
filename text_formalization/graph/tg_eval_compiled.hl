let f_LEAF_SEP_A =
  let no_abs_LEAF_SEP_A_case1, no_abs_LEAF_SEP_A_case2 =
    match List.map standardize (local_split_thm no_abs_LEAF_SEP_A) with
    | [th1; th2] -> (th1, th2)
    | _ -> failwith "error"
     in
  let var_g = standardize_tm (mk_var ("g", `:graph`)) in
  let var_f = standardize_tm (mk_var ("f", `:face`)) in
  let var_vl = standardize_tm (mk_var ("vl", `:((num)option)list`)) in
  let var_arcs = standardize_tm (mk_var ("arcs", `:(num#num#num#num)list`)) in
  let var_u = standardize_tm (mk_var ("u", `:num`)) in
  let var_cs = standardize_tm (mk_var ("cs", `:(num)list`)) in
  let rec f_LEAF_SEP_A tm1 tm2 tm3 tm4 tm5 opt_th =
    match (tm1, tm2, tm3, tm4, tm5) with
    | (g, f, vl, arcs, Const ("NIL", _)) -> trans_opt opt_th (INST [arcs, var_arcs; vl, var_vl; f, var_f; g, var_g] no_abs_LEAF_SEP_A_case1)
    | (g, f, vl, arcs, Comb (Comb (Const ("CONS", _), u), cs)) ->
      let base_th = trans_opt opt_th (INST [cs, var_cs; arcs, var_arcs; vl, var_vl; f, var_f; g, var_g; u, var_u] no_abs_LEAF_SEP_A_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (a2, Comb (Comb (_, a1), _)), a3)) ->
        let r1 = (a1, f_LEAF_SEP_A_abs1 g f vl arcs u) in
        let r2 = f_ALL_num r1 cs None in
        if is_true_th r2 then
          let th0 = MK_COMB (MK_COMB (REFL a2, r2), REFL a3) in
          let th1 = INST[a3, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          f_LEAF_SEP_A g f vl arcs cs (Some base_th)
        else
          let th0 = MK_COMB (MK_COMB (REFL a2, r2), REFL a3) in
          let th1 = INST[a3, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      | _ -> failwith "bad pattern"
      )
    | _ -> failwith "No match: f_LEAF_SEP_A"
     in
  f_LEAF_SEP_A
;;

let f_XLB_LEAF_A =
  let no_abs_XLB_LEAF_A_EXEC_case1 =
    match List.map standardize (local_split_thm no_abs_XLB_LEAF_A_EXEC) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_g = standardize_tm (mk_var ("g", `:graph`)) in
  let var_f = standardize_tm (mk_var ("f", `:face`)) in
  let var_vl = standardize_tm (mk_var ("vl", `:((num)option)list`)) in
  let var_cs = standardize_tm (mk_var ("cs", `:(num)list`)) in
  let var_s = standardize_tm (mk_var ("s", `:num`)) in
  let var_arcs = standardize_tm (mk_var ("arcs", `:(num#num#num#num)list`)) in
  let rec f_XLB_LEAF_A g f vl cs s arcs opt_th =
    let base_th = trans_opt opt_th (INST [cs, var_cs; vl, var_vl; g, var_g; arcs, var_arcs; s, var_s; f, var_f] no_abs_XLB_LEAF_A_EXEC_case1) in
    match concl base_th with
    | Comb (_, Comb (_, (Comb (Comb (a2, Comb (Comb (_, a1), _)), (Comb (_, (Comb ((Comb (_, a8) as a7), Comb (a6, Comb (Comb (a5, Comb (a3, _)), Comb (Comb (_, a4), _)))) as a9)) as a10)) as a11))) ->
      let r1 = f_DISTINCT_num cs None in
      if is_true_th r1 then
        let th0 = MK_COMB (MK_COMB (REFL a2, r1), REFL a11) in
        let th1 = INST[a11, p_var_bool] T_AND in
        let base_th = TRANS (TRANS base_th th0) th1 in
        let r2 = (a1, f_XLB_LEAF_abs1 g vl) in
        let r3 = f_ALL_num r2 cs None in
        if is_true_th r3 then
          let th0 = MK_COMB (MK_COMB (REFL a2, r3), REFL a10) in
          let th1 = INST[a10, p_var_bool] T_AND in
          let base_th = TRANS (TRANS base_th th0) th1 in
          let r4 = f_LEAF_SEP_A g f vl arcs cs None in
          if is_true_th r4 then
            let th0 = MK_COMB (MK_COMB (REFL a2, r4), REFL a9) in
            let th1 = INST[a9, p_var_bool] T_AND in
            let base_th = TRANS (TRANS base_th th0) th1 in
            let r5 = f_LENGTH_num_option vl None in
            let r6 =
              let r6 = MK_COMB (REFL a3, r5) in
              f_SQUANDER_FACE (rand (concl r5)) (Some r6) in
            let r7 = (a4, f_XLB_LEAF_A_abs2 vl g arcs) in
            let r8 = f_LIST_SUM_num r7 cs None in
            let r9 =
              let r9 = MK_COMB (MK_COMB (REFL a5, r6), r8) in
              f_ADD (rand (concl r6)) (rand (concl r8)) (Some r9) in
            let r10 =
              let r10 = MK_COMB (REFL a6, r9) in
              f_ADD s (rand (concl r9)) (Some r10) in
            let r11 = MK_COMB (REFL a7, r10) in
            f_LE a8 (rand (concl r10)) (Some (TRANS base_th r11))
          else
            let th0 = MK_COMB (MK_COMB (REFL a2, r4), REFL a9) in
            let th1 = INST[a9, p_var_bool] F_AND in
            TRANS (TRANS base_th th0) th1
        else
          let th0 = MK_COMB (MK_COMB (REFL a2, r3), REFL a10) in
          let th1 = INST[a10, p_var_bool] F_AND in
          TRANS (TRANS base_th th0) th1
      else
        let th0 = MK_COMB (MK_COMB (REFL a2, r1), REFL a11) in
        let th1 = INST[a11, p_var_bool] F_AND in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
  f_XLB_LEAF_A
;;

let f_XLB_LEAF_S =
  let XLB_LEAF_S_case1 =
    match List.map standardize (local_split_thm XLB_LEAF_S) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_g = standardize_tm (mk_var ("g", `:graph`)) in
  let var_f = standardize_tm (mk_var ("f", `:face`)) in
  let var_vl = standardize_tm (mk_var ("vl", `:((num)option)list`)) in
  let var_cs = standardize_tm (mk_var ("cs", `:(num)list`)) in
  let var_s = standardize_tm (mk_var ("s", `:num`)) in
  let rec f_XLB_LEAF_S g f vl cs s opt_th =
    let base_th = trans_opt opt_th (INST [vl, var_vl; f, var_f; g, var_g; s, var_s; cs, var_cs] XLB_LEAF_S_case1) in
    match concl base_th with
    | Comb (_, Comb (a2, Comb (Comb (a1, _), _))) ->
      let r1 = f_COUNT_VERTICES g None in
      let r2 =
        let r2 = MK_COMB (MK_COMB (REFL a1, r1), REFL vl) in
        f_PIECE_ARCS f (rand (concl r1)) vl (Some r2) in
      let r3 = MK_COMB (REFL a2, r2) in
      f_XLB_LEAF_A g f vl cs s (rand (concl r2)) (Some (TRANS base_th r3))
    | _ -> failwith "bad pattern"
     in
  f_XLB_LEAF_S
;;

let f_LB_PRUNED =
  let LB_PRUNED_EXEC_case1 =
    match List.map standardize (local_split_thm LB_PRUNED_EXEC) with
