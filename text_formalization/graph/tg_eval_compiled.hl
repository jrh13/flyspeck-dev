      else
        let th0 = MK_COMB (MK_COMB (MK_COMB (REFL a2, r3), REFL x), REFL mxs) in
        let th1 = INST [(x, var_t); (mxs, var_e)] COND_num_F in
        TRANS (TRANS base_th th0) th1
    | _ -> failwith "bad pattern"
     in
