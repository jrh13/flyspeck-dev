        f_LE (rand (concl r1)) (rand (concl r2)) (Some r3) in
      if is_true_th r3 then
        let th0 = MK_COMB (MK_COMB (MK_COMB (REFL a2, r3), REFL x), REFL mxs) in
        let th1 = INST [(x, var_t); (mxs, var_e)] COND_face_T in
