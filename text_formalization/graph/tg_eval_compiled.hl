let f_CV0 =
  let no_abs_CV0_EXEC_case1 =
    match List.map standardize (local_split_thm no_abs_CV0_EXEC) with
    | [th1] -> th1
    | _ -> failwith "error"
     in
  let var_t = standardize_tm (mk_var ("t", `:num`)) in
  let var_q = standardize_tm (mk_var ("q", `:num`)) in
  let var_nf = standardize_tm (mk_var ("nf", `:num`)) in
  let memo_f_CV0 = create_assoc_memo 1024 "f_CV0" in
  let rec f_CV0 t q nf opt_th =
    let key = List.map hash_string_of_term [t; q; nf] in
    try
      trans_opt opt_th (Assoc.find memo_f_CV0 key)
    with
    | Not_found ->
      let result =
