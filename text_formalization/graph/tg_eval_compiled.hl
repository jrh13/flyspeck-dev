            let th0 = MK_COMB (MK_COMB (REFL a5, r4), REFL a7) in
            let th1 = INST[a7, p_var_bool] F_AND in
            TRANS th0 th1 in
        let r6 = MK_COMB (REFL a8, r5) in
        f_NOT (rand (concl r5)) (Some (TRANS base_th r6))
    | _ -> failwith "bad pattern"
     in
