    match concl base_th with
    | Comb (_, Comb (Comb (a3, Comb ((Comb (_, a2) as a1), _)), (Comb (a8, Comb (Comb (a5, Comb (a4, _)), (Comb (a6, _) as a7))) as a9))) ->
