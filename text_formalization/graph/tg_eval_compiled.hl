    | (Comb (Comb (Const ("CONS", _), x), xs), n, (h, func_h)) ->
      let base_th = trans_opt opt_th (INST [h, var_h; n, var_n; xs, var_xs; x, var_x] UPDATE_AT_case2) in
      (match concl base_th with
      | Comb (_, Comb (Comb (Comb (a2, _), a7), (Comb ((Comb (a3, _) as a6), Comb (Comb (a5, Comb (_, (Comb (_, a1) as a4))), _)) as a8))) ->
        let r1 = f_EQ_num n a1 None in
