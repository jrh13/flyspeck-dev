open Tg_eval_support;;
let XLB_LEAF_EXEC = REWRITE_RULE[SQUANDER_TARGET] XLB_LEAF;;
let XLB_LEAF_A_EXEC = REWRITE_RULE[SQUANDER_TARGET] XLB_LEAF_A;;

(* the evaluator does not short-circuit ==> (it evaluated FACES_AT g w for *)
(* a new vertex w and failed); the conditional form is evaluated lazily     *)
let LEAF_SEP_OLD_EXEC = prove
 (`!g f u w. LEAF_SEP_OLD g f u w <=>
     (if w < COUNT_VERTICES g then
        ALL (\h. h = f \/ 4 < LENGTH (VERTICES h) /\ FINAL_FACE h \/
                 ~MEM u (VERTICES h)) (FACES_AT g w)
      else T)`,
  REPEAT GEN_TAC THEN REWRITE_TAC[LEAF_SEP_OLD] THEN
  COND_CASES_TAC THEN ASM_REWRITE_TAC[]);;

(* the evaluator's rule for XEXCESS_OF (tg_xstats.hl): no LET, no bare      *)
(* constant SQUANDER_TARGET                                                  *)
let XEXCESS_OF_EXEC =
  REWRITE_RULE[SQUANDER_TARGET]
    (PURE_REWRITE_RULE[LET_DEF; LET_END_DEF] XEXCESS_OF);;


(* Constants evaluated away in the rules (eval_compile cannot treat 0-ary    *)
(* non-constructor constants as values).                                     *)

let SQUANDER_VERTEX_EXEC = REWRITE_RULE[SQUANDER_TARGET] SQUANDER_VERTEX;;
let SQUANDER_FACE_EXEC = REWRITE_RULE[SQUANDER_TARGET] SQUANDER_FACE;;
let EXCESS_AT_TYPE_EXEC =
  REWRITE_RULE[SQUANDER_TARGET; EXCESS_T_COUNT; D3_CONST_VALUE; D4_CONST_VALUE;
               MULT_CLAUSES; SUB_0] EXCESS_AT_TYPE;;
let SIZE_PRUNED_EXEC = REWRITE_RULE[SQUANDER_TARGET] SIZE_PRUNED;;
let LB_PRUNED_EXEC = REWRITE_RULE[SQUANDER_TARGET] LB_PRUNED;;
let VCOUNT_PRUNED_VL_EXEC = VCOUNT_PRUNED_VL;;

let tame_default_db ~eliminate_abs () =
  let db = empty_db ~eliminate_abs "tame" in
  List.iter (fun c -> set_rule db c) [
    `(=):num->num->bool`;
    `+`; `-`; `SUC`; `*`; `PRE`; `<=`; `<`; `MIN`; `MAX`;
  ];
  ignore (add_thms db [
    "NOT_CLAUSES'", NOT_CLAUSES', [];
    "EQ_BOOL", EQ_BOOL, [];
    "EQ_PAIR", EQ_PAIR, [];
    "EQ_LIST", EQ_LIST, [];
    "EQ_FACE", EQ_FACE, [];
    "EQ_FACETYPE", EQ_FACETYPE, [];
  ]);
  add_extra_rule db ("REPLACE_NUMERALS", REPLACE_NUMERALS);
  List.iter (add_extra_rewrite db) ["GT", GT; "GE", GE];
  db;;

