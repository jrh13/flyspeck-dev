(* ========================================================================= *)
(* graph/tg_eval_db.hl                                                       *)
(*                                                                           *)
(* The rule database of the proof-producing evaluator: every function on the *)
(* evaluation path with its executable clause theorem (tg_exec.hl,           *)
(* tg_check.hl and the specification files), the numeral arithmetic rules    *)
(* of tg_eval_support.hl and the equality rules.  tame_db builds the         *)
(* database and the dependency groups for a result term; the generated OCaml *)
(* evaluator is written by write_rules_consts.  Requires compute-hol-light's *)
(* eval_compile.hl on the load path.                                         *)
(* ========================================================================= *)


(* the leaf check without the bare constant SQUANDER_TARGET *)

flyspeck_needs "graph/tg_eval_support.hl";;
flyspeck_needs "graph/tg_xcheck.hl";;
flyspeck_needs "graph/tg_newverts.hl";;
flyspeck_needs "graph/tg_enum_fast.hl";;
flyspeck_needs "graph/tg_xstats.hl";;
flyspeck_needs "graph/tg_enum_fast2.hl";;
flyspeck_needs "graph/tg_leaf.hl";;
flyspeck_needs "graph/tg_leaf_exec.hl";;
needs "graph/eval/eval_compile.hl";;

prioritize_num();;

