let tame_db ?(eliminate_abs = true) ?(counters = true) ?(inst_types = true)
            ?(result = `NEXT_PLANE p g`) rules =
  let db = add_thms (tame_default_db ~eliminate_abs ()) rules in
  let consts = dependencies db result ~inst_types in
  if counters then set_extra_for_all db (Extra_counter 0);
  set_extra_for_consts db (Extra_memo (Assoc_memo 64)) [`ENUMERATOR`];
  set_extra_for_consts db (Extra_memo (Assoc_memo 1024)) [`CV0`];
  db, consts;;
end;;
