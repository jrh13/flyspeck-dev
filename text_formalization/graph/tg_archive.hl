(* ========================================================================= *)
(* graph/tg_archive.hl                                                       *)
(*                                                                           *)
(* The tame graph archive as HOL data: ARCHIVE_CHUNKS is the list of 198     *)
(* chunks of (up to) 100 face graphs (lists of vertex lists), built from the *)
(* OCaml data of tg_archive_data.hl (Flyspeck's archive_all.ml order), and   *)
(* ARCHIVE = FLAT ARCHIVE_CHUNKS is the archive list of 19,715 graphs that   *)
(* the main theorem refers to.  MEM_ARCHIVE_EL is the lookup lemma used by   *)
(* the driver: the k-th graph of the i-th chunk is a member of ARCHIVE.      *)
(* ========================================================================= *)


(* Do not echo the 4 MB definition: abbreviate long lists while loading.    *)

flyspeck_needs "graph/tg_list.hl";;
flyspeck_needs "graph/tg_archive_data.hl";;

prioritize_num();;

module Tg_archive = struct

open Tg_list;;
open Tg_archive_data;;
let print_long_list =
  let rec dest n tm acc =
    if n <= 0 then (rev acc, true) else
    match tm with
    | Comb (Comb (Const ("CONS", _), h), t) ->
        (match t with
         | Const ("NIL", _) -> (rev (h :: acc), false)
         | _ -> dest (n - 1) t (h :: acc))
    | Const ("NIL", _) -> (rev acc, false)
    | _ -> failwith "dest_long_list" in
  fun fmt tm ->
    let tms, flag = dest 3 tm [] in
    Format.pp_print_string fmt "[";
    List.iteri (fun i h ->
      if i > 0 then Format.pp_print_string fmt "; ";
      Format.pp_print_string fmt (string_of_term h)) tms;
    if flag then Format.pp_print_string fmt " ..." else ();
    Format.pp_print_string fmt "]";;

install_user_printer ("long_list", print_long_list);;

let archive_chunks_tm =
  let num_ty = `:num` and face_ty = `:(num)list`
  and graph_ty = `:((num)list)list` in
  let mk_face f = mk_list (map mk_small_numeral f, num_ty) in
  let mk_graph (_,g) = mk_list (map mk_face g, face_ty) in
  let mk_chunk ch = mk_list (map mk_graph ch, graph_ty) in
  mk_list (map mk_chunk (tame_archive_data ()), `:(((num)list)list)list`);;

let ARCHIVE_CHUNKS = new_definition
  (mk_eq (mk_var ("ARCHIVE_CHUNKS", type_of archive_chunks_tm),
          archive_chunks_tm));;

delete_user_printer "long_list";;

let ARCHIVE = new_definition
 `ARCHIVE = FLAT ARCHIVE_CHUNKS`;;

let MEM_EL = prove
 (`!l:A list k. k < LENGTH l ==> MEM (EL k l) l`,
  REWRITE_TAC[MEM_EXISTS_EL] THEN MESON_TAC[]);;

let MEM_ARCHIVE_EL = prove
 (`!i k. i < LENGTH ARCHIVE_CHUNKS /\ k < LENGTH (EL i ARCHIVE_CHUNKS)
         ==> MEM (EL k (EL i ARCHIVE_CHUNKS)) ARCHIVE`,
  REPEAT STRIP_TAC THEN REWRITE_TAC[ARCHIVE; MEM_FLAT] THEN
  EXISTS_TAC `EL i ARCHIVE_CHUNKS` THEN ASM_SIMP_TAC[MEM_EL]);;

let LENGTH_ARCHIVE_CHUNKS = prove
 (`LENGTH ARCHIVE_CHUNKS = 198`,
  REWRITE_TAC[ARCHIVE_CHUNKS; LENGTH] THEN CONV_TAC NUM_REDUCE_CONV);;
end;;
