(* ========================================================================= *)
(* graph/tg_classification.hl -- the final step: from the four class        *)
(* theorems TFO ARCHIVE p (SEED p) (p = 0..3) and the archive equality,      *)
(* Flyspeck's import_tame_classification.  The class theorems are proved by  *)
(* the certificate driver (graph/tg_driver.hl); their source here is         *)
(* pluggable, set with set_class_theorems:                                   *)
(*   - graph/tg_graph_import.hl imports them by statement digest             *)
(*     (general/theorem_graph_digest.hl), as nonlinear/mk_all_ineq.hl        *)
(*     imports the nonlinear inequalities;                                   *)
(*   - a class proved in the same session by Tg_driver.run_class can be      *)
(*     installed directly.                                                   *)
(* graph_classification () returns |- import_tame_classification once a      *)
(* source is set.                                                            *)
(* ========================================================================= *)

flyspeck_needs "graph/tg_bridge_main.hl";;
flyspeck_needs "graph/tg_bridge_archive.hl";;

prioritize_num();;

module Tg_classification = struct

open Tg_bridge_main;;
open Tg_bridge_archive;;

(* source of the class theorems; p ranges over 0..3 (Tri, Quad, Pent, Hex) *)
let class_theorem : (int -> thm) ref =
  ref (fun _ -> failwith
    ("Tg_classification: no class-theorem source; load " ^
     "graph/tg_graph_import.hl or install proved theorems with " ^
     "set_class_theorems"));;

let set_class_theorems f = class_theorem := f;;

(* |- import_tame_classification, from the four class theorems and H_ARCHIVE *)
let graph_classification () =
  MP IMPORT_TAME_CLASSIFICATION_FROM_RUNS
     (end_itlist CONJ
        (H_ARCHIVE :: map (fun p -> !class_theorem p) [0; 1; 2; 3]));;

end;;
