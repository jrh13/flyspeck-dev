.DS_Store
\#*\#
*~
*.swp
*.swo
*.cmo
*.cmi
*.o
*.cmx

# Products of azure/Makefile
/azure/native_verifier
/azure/native_verifier_raw.ml
/azure/native_verifier_inlined.ml
/azure/sharp_verifier
/azure/sharp_verifier_raw.ml
/azure/sharp_verifier_inlined.ml

# Products of an azure verification run
/azure/out/
/azure/out_sharp.txt
/azure/run-parallel*.joblog
/azure/pars-resume.txt

# Default output of text_formalization/build/checkpoint_flyspeck
/flyspeck-checkpoint
/flyspeck-checkpoint.ckpt/

# Generated by Build_certificates.make_models
/formal_lp/glpk/graph_all.mod
/formal_lp/glpk/model2.mod

# Working directory of a certificate run; 000.txt is part of the repository
/formal_lp/glpk/tmp/*
!/formal_lp/glpk/tmp/000.txt

# A run in parallel gives each process its own tmp_dir and model2_path
/formal_lp/glpk/tmp_*/
/formal_lp/glpk/model2_*.mod

# Where read_lp_certificates unpacks a .tar.gz; create_tmp_dir refuses to
# reuse it unless it is empty, so a failed read has to be cleaned up by hand
/formal_lp/glpk/binary/tmp/
graph_native/certgen
